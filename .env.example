NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# REQUIRED — generate a long random string
SESSION_SECRET=replace-with-long-random-secret

# REQUIRED in production — change from default
ADMIN_KEY=bb-admin-2026

# Resend — required for email notifications (free at resend.com)
# 1. Sign up at https://resend.com
# 2. Add & verify your domain bankruptcybets.com under Domains
# 3. Create an API key under API Keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender address — must use your verified domain above
# e.g. noreply@bankruptcybets.com or rgj@rolandjones.com (if that domain is verified)
# During initial testing only, you can use: onboarding@resend.dev
RESEND_FROM=noreply@bankruptcybets.com
